    { "_id": "fld_auth", "_type": "request_group", "parentId": "wrk_deckforge", "name": "0. Autenticação (Supabase)", "metaSortKey": 1 },
    {
      "_id": "req_login",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Login (gerar token)",
      "description": "Gera um access_token do Supabase para usar nas rotas protegidas. Preencha supabase_url e supabase_anon_key no Environment (valores do seu .env). Copie o 'access_token' da resposta para a variável 'token' do Environment.",
      "method": "POST",
      "url": "{{ _.supabase_url }}/auth/v1/token?grant_type=password",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "apikey", "value": "{{ _.supabase_anon_key }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ _.test_email }}\",\n  \"password\": \"{{ _.test_password }}\"\n}"
      },
      "metaSortKey": 1
    },

