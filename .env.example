NODE_ENV=development
PORT=3333

# Supabase > Project Settings > Database > Connection string
# DATABASE_URL = "Connection pooling" (porta 6543, modo transaction) - usada em runtime pela aplicacao
# DIRECT_URL   = "Direct connection" (porta 5432) - usada pelo Prisma Migrate para rodar DDL
DATABASE_URL=
DIRECT_URL=

# Preenchido na etapa 4 (Supabase Auth) - Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opcional - sem a chave a Pokemon TCG API funciona, com limite de requisicoes menor
# Chave gratuita em https://dev.pokemontcg.io
POKEMON_TCG_API_KEY=
