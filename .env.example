NODE_ENV=development
PORT=3333

# Supabase > Project Settings > Database > Connection string
# DATABASE_URL = "Connection pooling" (porta 6543, modo transaction) - usada em runtime pela aplicacao
# DIRECT_URL   = "Direct connection" (porta 5432) - usada pelo Prisma Migrate para rodar DDL
DATABASE_URL=
DIRECT_URL=

# Preenchido na etapa 4 (Supabase Auth) - Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Preenchido na etapa 5 (Pokemon TCG API)
POKEMON_TCG_API_KEY=
